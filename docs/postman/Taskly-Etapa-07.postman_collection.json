            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "HTTP 201. Erros: 400 dados inválidos; 401 sem sessão; 403 origem; 404 registro inacessível; 409 integridade; 500 persistência. O cookie de login é mantido pelo Postman.",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"name\": \"Estudante Taskly\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
