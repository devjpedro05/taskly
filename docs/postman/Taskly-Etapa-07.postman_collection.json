{
  "info": {
    "name": "Taskly — Etapa 07",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "SQLite e autenticação por cookie. Configure email único e password (8+ caracteres e até 72 bytes) antes de executar. Inicie a API com FRONTEND_ORIGIN igual à variável frontendOrigin. Execute os grupos na ordem. Postman mantém o cookie HttpOnly. Logout está ao final de Subtasks. Cada DELETE usa somente um registro criado por esta coleção; a atividade principal permanece para demonstrar persistência."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173",
      "type": "string"
    },
    {
      "key": "email",
      "value": "seu-email@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "subjectId",
      "value": "",
      "type": "string"
    },
