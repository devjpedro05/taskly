            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "description": "HTTP 204. Erros: 400 dados inválidos; 401 sem sessão; 403 origem; 404 registro inacessível; 409 integridade; 500 persistência. O cookie de login é mantido pelo Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
